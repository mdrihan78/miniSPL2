<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.trackfleet.controllers.ParcelCreateController">
    <HBox spacing="10">
        <Label text="Create New Parcel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Button text="Refresh Data" onAction="#refreshData"/>
    </HBox>
    
    <GridPane hgap="10" vgap="10">
        <Label text="Sender:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="senderCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Receiver:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="receiverCombo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <Label text="Origin:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="originCombo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        
        <Label text="Destination:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="destCombo" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        
        <Label text="Weight (kg):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="weightField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        
        <Label text="Delivery Type:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <ComboBox fx:id="strategyCombo" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    
    <Button text="Create Parcel &amp; Calculate Price" onAction="#createParcel" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    <Label fx:id="resultLabel" style="-fx-text-fill: green;"/>
</VBox>
